# ─── EcoTrack backend environment ────────────────────────────────────────────
# Copy this file to ".env" in the backend/ folder and adjust for your machine.
# spring-dotenv loads it automatically at startup. All values have safe local
# defaults in application.properties, so .env is optional for quick local runs.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecotrack
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT signing secret — MUST be at least 32 characters. Change this!
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Token lifetime in milliseconds (default 24h)
JWT_EXPIRATION_MS=86400000

# Comma-separated list of allowed frontend origins (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173
